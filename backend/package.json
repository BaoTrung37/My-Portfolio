{
  "name": "@portfolio/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dedicated Express REST API backend for personal portfolio",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/backend/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "NODE_ENV=test tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "NODE_ENV=test tsx --test tests/unit/*.test.ts",
    "test:integration": "NODE_ENV=test tsx --test tests/integration/*.test.ts",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@portfolio/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "pg": "^8.11.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.11.3",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  }
}
